# Copiar como .env.test (no se sube a git). Base LOCAL para `npm test`: se borra y se rearma en
# cada corrida. El nombre tiene que terminar en _auto_test y el host ser local, si no los tests no corren.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynamicgym_auto_test
DB_USER=postgres
DB_PASS=tu_password_local
DB_SSL=false
JWT_SECRET=secreto-solo-para-tests
