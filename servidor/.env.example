# ─────────────────────────────────────────────────────────────────
#  PLANTILLA DE VARIABLES DE ENTORNO — Dynamic Gym API
#  Copiá este archivo como ".env" y completá los valores reales.
#  NUNCA subas ".env" a git. Solo ".env.example" va al repositorio.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development        # "development" | "production"
PORT=3001                   # Render asigna el suyo automáticamente

# ── Base de datos ─────────────────────────────────────────────────
# OPCIÓN A (producción en Render): usa DATABASE_URL
DATABASE_URL=               # Render la genera sola, dejá vacío en local

# OPCIÓN B (local): usa las variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynamicgym
DB_USER=postgres
DB_PASS=TU_PASSWORD_AQUI

# SSL: false en local, true en Render/producción
DB_SSL=false

# ── Seguridad ─────────────────────────────────────────────────────
# OBLIGATORIO en producción. Generá uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UNO_LARGO_Y_ALEATORIO

# ── CORS ──────────────────────────────────────────────────────────
# Vacío = permite todos los orígenes (OK cuando front y back están juntos)
# Ejemplo: https://tu-gym.onrender.com,https://www.tu-gym.com
CORS_ORIGIN=
