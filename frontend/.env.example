# URL base del API.
# LOCAL: apunta al servidor de desarrollo
VITE_API_URL=http://localhost:3001/api

# PRODUCCIÓN (en Render): el front vive en el mismo servidor,
# usá ruta relativa para que funcione sin importar el dominio
# VITE_API_URL=/api
